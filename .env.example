# Local: docker compose up -d   (Postgres on port 5433)
# Production: your RDS URL, e.g. postgres://user:pass@your-db.xxxx.us-east-1.rds.amazonaws.com:5432/secret_santa
DATABASE_URL=postgres://postgres:postgres@localhost:5433/secret_santa
# TLS: "verify" for AWS RDS (verifies the server certificate), "require" for encryption only, "false" for local Docker
DATABASE_SSL=false

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# The app's public URL. Also used to build the personal links you text to participants.
BETTER_AUTH_URL=http://localhost:3000
